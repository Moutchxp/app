<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Déclencheur launchd de la veille Sitadel (chantier S11b). NE FAIT LE TRAVAIL LOURD QUE via `npm run veille:run`, qui
  appelle executerVeille : verrou (un seul run à la fois), millésime bon marché (rien à faire si inchangé), ingestion +
  purge scopée sinon. Passe tous les quarts d'heure ; consomme aussi une éventuelle « demande manuelle » posée depuis
  l'écran. RunAtLoad=false : pas de run au chargement (on ne veut pas déclencher une ingestion en installant le job).

  ⚠️ launchd N'A PAS DE PATH ni de shell : d'où `/bin/zsh -lc` (shell de LOGIN → PATH complet, node/npm trouvés) et
  `cd` vers la racine ABSOLUE du dépôt. Le CLI charge `.env` en absolu (app/lib/chargerEnv.ts).
  ⚠️ Ce job ne tourne que MACHINE ALLUMÉE et session ouverte (LaunchAgent) — le 24/24 suppose un hébergement.

  Chemins à adapter si le dépôt ou l'utilisateur diffèrent (cf. ops/README.md).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sansvisavis.veille</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/macbookprom4arnaud/sansvisavis/app &amp;&amp; npm run veille:run</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/macbookprom4arnaud/Library/Logs/svav-veille.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/macbookprom4arnaud/Library/Logs/svav-veille.log</string>
</dict>
</plist>
