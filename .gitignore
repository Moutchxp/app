# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# données géographiques volumineuses (dalles LiDAR, etc.) — JAMAIS committées
/app/data/

# BDNB open data (année de construction, scratch dept 92) — JAMAIS committée
/data/bdnb/

# Parcs & jardins OCS GE (scratch d'inspection) — JAMAIS committée
/data/parcs_jardins/

# Sitadel (CSV open data téléchargés par sitadel:ingest) — JAMAIS committés (volumineux, re-téléchargeables)
/data/sitadel/

# CSV de l'annuaire CADA téléchargé par prada:ingest — JAMAIS committé (millésimé, re-téléchargeable)
/data/prada/

# ADMIN EXPRESS communes (GeoJSON IGN téléchargé par commune:import) — JAMAIS committé (re-téléchargeable)
/data/commune/

# Annuaire mairies (agrégat DILA téléchargé par mairie:contact:import) — JAMAIS committé (re-téléchargeable)
/data/mairie/

# Archive DILA « Base de données locales » (tar.bz2 ~348 Mo + JSON ~259 Mo) — dila:ingest télécharge HORS DÉPÔT (tmpdir) et
# nettoie en fin de run ; cette entrée est un garde-fou si $DILA_DIR pointe ici. JAMAIS committé (volumineux, re-téléchargeable).
/data/dila/

# Sorties locales de dump (ged:dump, etc.) — jamais committées (contenu de documents de mairie, re-générables)
/.tmp/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# certificats HTTPS de dev (clé privée — jamais committée)
/certs
certificates/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# passation locale (générée par le skill /passation) — jamais committée
PASSATION.md

# MinIO — stockage S3 local de dev (binaire ~100 Mo + données = photos de logements + PDF nominatifs de test) : JAMAIS committés
/.minio/

# bac à sable de test (ex. essais du skill /svav-build) — jamais committé
sandbox/

# fichier d'état jetable du state-manager de /svav-build
docs/.svav-build-state.md
