# GABARIT — les marqueurs entre arobases sont remplacés par installer.sh à partir de svav.conf. Ne pas copier tel quel.
#
# Équivalent de ops/com.sansvisavis.gestion-continu.plist : relève continue du courrier de gestion.
# Processus de LONGUE DURÉE qui tient sa propre boucle (intervalle lu en base) → PAS de timer.
# KeepAlive + ThrottleInterval 60 de launchd = Restart=always + RestartSec=60 ici.
[Unit]
Description=Sans Vis-à-Vis — relève continue du courrier de gestion
Documentation=file:@APP_DIR@/deploy/systemd/README.md
Wants=network-online.target
After=network-online.target postgresql.service
# Mail immédiat à Arno si cette unité échoue (svav-alerte@.service, surveillance du serveur).
OnFailure=svav-alerte@%n.service
# Ne jamais abandonner les relances (launchd KeepAlive n'abandonne jamais non plus).
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SVAV_USER@
Group=@SVAV_GROUP@
WorkingDirectory=@APP_DIR@
Environment=TZ=Europe/Paris
Environment=PATH=@PATH@
# Même commande que `npm run gestion:relever-continu`.
ExecStart=@NODE@ @APP_DIR@/node_modules/tsx/dist/cli.mjs @APP_DIR@/app/scripts/relever-gestion-continu.ts
Restart=always
RestartSec=60
# `systemctl stop` envoie SIGTERM : le script finit son tour proprement et rend le verrou.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=svav-gestion-continu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
