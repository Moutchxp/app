# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# Modèle du fichier .env — NOMS seulement. Ne jamais y mettre une vraie valeur (secrets, mots de passe, jetons).
# Référence : docs/RECON_PORTABILITE_SERVEUR.md §1. Aucune variable NEXT_PUBLIC_ : tout est lu côté serveur.
# Une variable laissée vide prend le défaut du code (indiqué en commentaire) ou désactive la fonction concernée.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════

# ─── Système ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Fuseau du processus : RECOMMANDÉ (non lu par le code, mais ~22 calculs se font en heure locale — cf. recon §6).
TZ=Europe/Paris
# Mode d'exécution, posé par Next (next dev / next start) : en production, cookies « secure » et garde https de SITE_URL.
# NODE_ENV=

# ─── Base de données PostgreSQL / PostGIS ────────────────────────────────────────────────────────────────────────
# Connexion PostgreSQL (obligatoire). Sur un serveur, préciser l'utilisateur dans l'URL.
DATABASE_URL=postgresql://localhost:5432/sansvisavis
# Plafond d'exécution d'une requête du pool d'analyse publique, en ms (défaut 15000).
ANALYSE_STATEMENT_TIMEOUT_MS=
# Attente max d'une connexion du pool d'analyse, en ms (défaut 10000).
ANALYSE_CONNECT_TIMEOUT_MS=
# Nombre max de connexions du pool d'analyse (défaut 10).
ANALYSE_POOL_MAX=
# Nombre max de connexions du pool analytique (défaut 2).
ANALYTICS_POOL_MAX=
# Attente max d'une connexion analytique, en ms (défaut 2000).
ANALYTICS_CONNECT_TIMEOUT_MS=
# statement_timeout des connexions analytiques, en ms (défaut 3000).
ANALYTICS_STATEMENT_TIMEOUT_MS=
# Fermeture d'une connexion analytique inactive, en ms (défaut 10000).
ANALYTICS_IDLE_TIMEOUT_MS=
# idle_in_transaction_session_timeout des connexions analytiques, en ms (défaut 3000).
ANALYTICS_IDLE_IN_TX_TIMEOUT_MS=
# Abandon côté JS d'une écriture analytique, en ms (défaut 2000).
ANALYTICS_ECRITURE_TIMEOUT_MS=

# ─── URL publiques (contrôlées au démarrage en production : avertissement si absentes ou locales) ────────────────
# URL PUBLIQUE ABSOLUE du site (ex. https://www.sansvisavis.com), SERVEUR uniquement (jamais NEXT_PUBLIC_ : elle
# n'est construite que côté serveur, dans le QR/lien de vérification du certificat PDF). Doit inclure le schéma
# http(s). ABSENTE ou mal formée → le PDF N'EST PAS généré : un QR pointant vers une URL fausse serait pire qu'un
# certificat sans document (la carte/le PDF sont re-fabricables une fois la variable posée).
SITE_URL=
# Adresse de l'application dans les liens agenda / Accepter-Refuser de la gestion (défaut http://localhost:3000).
GESTION_URL_APPLICATION=https://exemple.fr
# Racine des liens des alertes d'envoi de la gestion (défaut http://localhost:3000).
SVAV_URL_PUBLIQUE=https://exemple.fr

# ─── Interface admin ─────────────────────────────────────────────────────────────────────────────────────────────
# Interface admin (Étape 1). Ne jamais préfixer NEXT_PUBLIC_ : secrets serveur uniquement.
# Mot de passe admin (ancienne voie).
ADMIN_PASSWORD=
# Clé de signature du cookie admin (obligatoire : exception si absente).
ADMIN_SESSION_SECRET=
# Hash argon2 du mot de passe admin, encodé en base64 (voie de secours).
ADMIN_PASSWORD_ARGON2_B64=

# ─── Module Internaute ───────────────────────────────────────────────────────────────────────────────────────────
# Module Internaute — secret DÉDIÉ des jetons-capacité de rectification publique. DISTINCT du secret admin
# (ne jamais réutiliser ADMIN_SESSION_SECRET). Secret aléatoire ≥ 32 octets.
INTERNAUTE_TOKEN_SECRET=
# Module Internaute — secret DÉDIÉ de la SESSION client (comptes self-service). DISTINCT d'ADMIN_SESSION_SECRET ET
# d'INTERNAUTE_TOKEN_SECRET (séparation stricte : session ≠ jetons-capacité ≠ admin). Secret aléatoire ≥ 32 octets.
# ABSENT → la signature de session throw (fail-closed) : la connexion internaute est indisponible.
INTERNAUTE_SESSION_SECRET=
# Durée de vie de la session client, en SECONDES. Optionnel — défaut 30 jours (2592000). Ex. 604800 = 7 jours.
SESSION_INTERNAUTE_TTL=
# En-tête d'adresse IP client de confiance posé par le proxy (ex. x-forwarded-for, cf-connecting-ip). Vide = aucun
# en-tête cru : tous les visiteurs anonymes partagent un même quota. À poser derrière un proxy.
CADENCE_ENTETE_IP=

# ─── E-mail : compte « entreprise » (SMTP_*) ─────────────────────────────────────────────────────────────────────
# Envoi du certificat par e-mail (SMTP Google Workspace, via nodemailer). SERVEUR uniquement (jamais NEXT_PUBLIC_).
# ⚠️ SMTP_USER ≠ MAIL_FROM : noreply@sansvisavis.com est un ALIAS Workspace (pas une boîte, il ne peut pas
# s'authentifier). On S'AUTHENTIFIE avec le compte réel (SMTP_USER) et on ENVOIE EN TANT QUE l'alias (MAIL_FROM).
# SMTP_PASS est un MOT DE PASSE D'APPLICATION Workspace : ne JAMAIS mettre sa valeur ici, ni en git, ni dans un log.
# Une variable absente/mal formée → PAS d'envoi (log + return) : un envoi à moitié configuré est pire qu'absent.
# Serveur SMTP du compte entreprise.
SMTP_HOST=
# Port SMTP (465 ou 587).
SMTP_PORT=
# Compte d'authentification SMTP (sert aussi à la relève IMAP).
SMTP_USER=
# Mot de passe d'application SMTP (sert aussi à la relève IMAP).
SMTP_PASS=
# Adresse expéditrice affichée (alias).
MAIL_FROM=
# Serveur IMAP de relève du compte entreprise (défaut imap.gmail.com).
IMAP_HOST=
# Port IMAP de relève du compte entreprise (défaut 993, TLS toujours actif).
IMAP_PORT=

# ─── E-mail : boîte personnelle (infixe PERSONNE_) ───────────────────────────────────────────────────────────────
# Serveur SMTP de la boîte personnelle (profil inactif si une des 4 variables manque).
SMTP_PERSONNE_HOST=
# Port SMTP de la boîte personnelle.
SMTP_PERSONNE_PORT=
# Compte SMTP de la boîte personnelle (sert aussi à sa relève IMAP).
SMTP_PERSONNE_USER=
# Mot de passe d'application de la boîte personnelle. Une seule occurrence dans le .env (la dernière l'emporte).
SMTP_PERSONNE_PASS=
# Serveur IMAP de la boîte personnelle (défaut imap.gmail.com).
IMAP_PERSONNE_HOST=
# Port IMAP de la boîte personnelle (défaut 993).
IMAP_PERSONNE_PORT=

# ─── Google : Drive (permis) ─────────────────────────────────────────────────────────────────────────────────────
# Client OAuth du Drive (permis), réutilisé par défaut pour gestion@.
GOOGLE_DRIVE_CLIENT_ID=
# Secret du client OAuth du Drive.
GOOGLE_DRIVE_CLIENT_SECRET=
# Jeton de rafraîchissement OAuth du Drive.
GOOGLE_DRIVE_REFRESH_TOKEN=

# ─── Google : gestion@ ───────────────────────────────────────────────────────────────────────────────────────────
# LOT 5-GOOGLE — connexion Google de gestion@criterimmo.fr (NOMS seulement, valeurs jamais committées).
# Facultatif : sans elles, le client OAuth du Drive existant (GOOGLE_DRIVE_CLIENT_*) est réutilisé.
GOOGLE_GESTION_CLIENT_ID=
GOOGLE_GESTION_CLIENT_SECRET=
# Facultatif : déplace le fichier du jeton (defaut ~/.config/sansvisavis/google-gestion.json).
GOOGLE_GESTION_JETON_FICHIER=
# Jeton de rafraîchissement gestion@ passé par l'environnement (prioritaire sur le fichier ci-dessus).
GOOGLE_GESTION_REFRESH_TOKEN=
# Adresse du compte associé à GOOGLE_GESTION_REFRESH_TOKEN.
GOOGLE_GESTION_COMPTE=
# Chemin du fichier de clé du compte de service (Drive délégué, Agenda). Chemin absolu propre à la machine.
GOOGLE_DELEGATION_CLE_FICHIER=
# Clé du compte de service en JSON direct (alternative au fichier).
GOOGLE_DELEGATION_CLE_JSON=
# Clé AES du coffre des jetons Google (utilisée par le CLI de purge).
GESTION_JETON_CLE=

# ─── Stockage objet S3 / MinIO ───────────────────────────────────────────────────────────────────────────────────
# Point d'accès S3 (MinIO ou S3 OVH), contrôlé au démarrage en production (avertissement si absent ou local).
S3_ENDPOINT=https://s3.exemple.fr
# Nom du bucket (privé).
S3_BUCKET=
# Identifiant d'accès S3.
S3_ACCESS_KEY_ID=
# Clé secrète S3.
S3_SECRET_ACCESS_KEY=
# Région (défaut us-east-1 ; MinIO l'ignore mais le SDK l'exige).
S3_REGION=
# 'true' pour MinIO (path-style) ; absent/false pour un fournisseur à vhost.
S3_FORCE_PATH_STYLE=
# Validité des URL signées, en secondes (défaut 900).
S3_URL_EXPIRATION_S=
# Taille max d'un objet déposé, en Mo (défaut 15).
S3_TAILLE_MAX_MO=

# ─── IA ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Clé de l'API Gemini (analyse photo — score de qualité de vue uniquement).
GEMINI_API_KEY=
# Clé de l'API Mistral (OCR Cerfa / planches des permis).
MISTRAL_API_KEY=

# ─── Veille DILA / Sitadel ───────────────────────────────────────────────────────────────────────────────────────
# URL de secours du fichier DILA (la config en base prime ; défaut : URL data.gouv.fr du code).
DILA_URL=
# Dossier de travail DILA hors dépôt (défaut <tmpdir>/svav-dila ; ~600 Mo).
DILA_DIR=

# ─── Carte et certificat PDF ─────────────────────────────────────────────────────────────────────────────────────
# Nombre de tuiles IGN téléchargées en parallèle (défaut 8).
CARTE_TUILES_CONCURRENCE=
# Budget de temps du téléchargement des tuiles, en ms (défaut 20000).
CARTE_TUILES_BUDGET_MS=
# Qualité JPEG de la carte du certificat, 1 à 100 (défaut 80).
CERTIFICAT_CARTE_QUALITE_JPEG=

# ─── Bancs d'essai (scripts CLI uniquement) ──────────────────────────────────────────────────────────────────────
# Fournisseur du banc vision : gemini ou mistral (défaut gemini).
BANC_FOURNISSEUR=
# Modèle Gemini du banc vision (défaut gemini-2.5-flash).
GEMINI_MODEL=
# Modèle Mistral du banc vision (défaut pixtral-12b-2409).
MISTRAL_MODEL=
# Compte mesuré par le banc de dépôt Drive (défaut gestion@criterimmo.fr).
MESURE_COMPTE=
